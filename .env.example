# META_ACCESS_TOKEN: Meta Graph API / Facebook Ads Archive Access Token
# Required for live Meta Ads Archive scraping. Set as a secret in Vercel or environment variable.
META_ACCESS_TOKEN=

# FIRECRAWL_API_KEY: Optional Firecrawl API Key to crawl destination links and extract lead emails
# Set as a secret in Vercel or environment variable.
FIRECRAWL_API_KEY=

# GEMINI_API_KEY: Required for Gemini AI ad insights and creative copywriting audits.
# AI Studio automatically injects this at runtime from user secrets. Set as a secret in Vercel.
GEMINI_API_KEY=

# APP_URL: The URL where this app is hosted.
APP_URL=
